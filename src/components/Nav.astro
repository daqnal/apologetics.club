---
import { SITE_NAME } from "../consts.ts";
import { Search, ScrollText, Info } from "lucide-react";
---

<div class="navbar bg-base-100/95 rounded-box" id="nav">
    <div class="navbar-start">
        <a href="" class="btn text-lg">{SITE_NAME}</a>
    </div>

    <div class="navbar-end">
        <div class="rounded-box" id="nav-btn-container">
            <button class="btn btn-circle">
                <Search />
            </button>
            <button class="btn btn-circle">
                <ScrollText />
            </button>
            <button class="btn btn-circle">
                <Info />
            </button>
        </div>
    </div>
</div>

<style>
    #nav {
        margin-top: 8px;
        margin-bottom: 8px;
        height: 48px;
        width: calc(100% - 16px);
    }

    #nav-btn-container {
    }
</style>
